# ---------------------------------------------------------------- core
APP_ENV=development                 # development | test | production
PUBLIC_APP_URL=http://localhost:3000 # (docker compose: http://localhost:8080) public origin of the web app (used for redirects, callbacks, emails)
SECRET_KEY=change-me-to-a-long-random-string   # REQUIRED in production (openssl rand -hex 32)
# Fernet keys (comma separated; first encrypts, all decrypt). REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
DATABASE_URL=postgresql+psycopg://seo:seo@localhost:5432/seo
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=celery                 # celery (production) | inline (local dev / e2e only)
BOOTSTRAP_ADMIN_EMAIL=              # user who signs up with this email becomes platform admin

# ---------------------------------------------------------------- crawler limits
CRAWLER_USER_AGENT=RankLensBot/0.1 (+https://your-domain.example/bot)
CRAWLER_ALLOWED_PORTS=80,443
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_CONCURRENCY=3
CRAWLER_DELAY_SECONDS=0.25
CRAWLER_HARD_MAX_PAGES=2000
PUBLIC_AUDIT_MAX_PAGES=10
# DEV/TEST ONLY. Hostnames allowed to resolve to private addresses (e.g. local fixture sites).
# Refused when APP_ENV=production.
SSRF_DEV_ALLOW_HOSTS=

# ---------------------------------------------------------------- JS rendering (optional, Pro+ plans)
RENDERING_ENABLED=false
CHROMIUM_EXECUTABLE_PATH=           # optional; defaults to Playwright's bundled Chromium

# ---------------------------------------------------------------- AI (optional)
AI_PROVIDER=none                    # none | anthropic | mock (mock is for tests/demos; refused in production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium                    # low | medium | high | xhigh | max
AI_REFUSAL_FALLBACK=true            # server-side refusal fallback (Anthropic beta)

# ---------------------------------------------------------------- keyword data (optional)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---------------------------------------------------------------- billing
BILLING_MODE=dev                    # dev (simulated, clearly labelled; refused in production) | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # endpoint: POST {PUBLIC_APP_URL}/api/billing/webhook
STRIPE_PRICE_STARTER=               # recurring monthly CAD price ids
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# PLANS_OVERRIDE_JSON={"pro": {"price_cad_month": 109}}

# ---------------------------------------------------------------- WordPress integration
WORDPRESS_APP_ID=4f3b8a3e-7d0e-4b8e-9b44-2b1f2b6d9c11   # stable UUID identifying this app to WordPress

# ---------------------------------------------------------------- email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------- retention & limits
SNAPSHOT_RETENTION_DAYS=90
ANONYMOUS_AUDIT_RETENTION_DAYS=7
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PUBLIC_AUDIT_PER_HOUR=5

# ---------------------------------------------------------------- frontend
BACKEND_URL=http://127.0.0.1:8000   # where Next.js proxies /api/* (server side only)

# Google Search Console (optional). Create an OAuth 2.0 "Web application" client in Google Cloud,
# enable the Search Console API, and add the redirect URI: <PUBLIC_APP_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
